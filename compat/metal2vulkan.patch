+/// Loading a `<4 x float>` from a `[8 x <3 x float>]` local reads the leading `float3` and its padding
+/// lane (Metal stores `float3` in 16 bytes): load element 0 as `<3 x float>` and widen it. Roblox's
+/// fragment shaders 2018-2032 failed with "cannot reinterpret load … Array(Vector(Float, 3), 8) to
+/// Vector(Float, 4)" before this.
+#[test]
+fn native_leading_vector_aggregate_load_widens_three_lanes_to_four() {
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define <4 x float> @load_leading_vec_widened() {
+entry:
+  %buf = alloca [8 x <3 x float>], align 16
+  %v = load <4 x float>, ptr %buf, align 16
+  ret <4 x float> %v
+}
+"#;
+    let asm = disassemble(&emit_vulkan_spirv(ll).expect("native emit")).expect("disassemble");
+    assert!(asm.contains("OpInBoundsAccessChain"), "{asm}");
+    assert!(asm.contains("OpCompositeConstruct"), "{asm}");
+    assert!(asm.contains("OpConstantNull"), "{asm}");
+    assert!(!asm.contains("OpBitcast %_ptr_"), "{asm}");
+}
+
