+// same route as links from the embedded browser: the client's own URL handler.
+struct LinkClient {int fd;std::string text;};
+static gboolean link_readable(gint fd,GIOCondition condition,gpointer data) {
+    auto c=(LinkClient*)data;char buffer[4096];ssize_t n=read(fd,buffer,sizeof buffer);
+    if(n>0)c->text.append(buffer,n);
+    if(n>0 && c->text.size()<=16384 && c->text.find('\n')==std::string::npos)return G_SOURCE_CONTINUE;
+    if(n<0 && errno==EAGAIN && !(condition&(G_IO_HUP|G_IO_ERR)))return G_SOURCE_CONTINUE;
+    std::string url=c->text.substr(0,c->text.find('\n'));
+    if(rbx_client_url(url.c_str())) {
+        auto o=event(nullptr,"launch-url");json_object_set_string_member(o,"url",url.c_str());send_object(o);
